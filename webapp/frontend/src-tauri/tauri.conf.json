{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Program Scheduler",
  "version": "0.0.0",
  "identifier": "com.example.musicprogramscheduler",
  "build": {
    "beforeDevCommand": "npm run build:tauri-api && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && npm run build:tauri-api",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Music Program Scheduler",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../../backend/dist/pianist-scheduling-api"]
  }
}
